# =============================================================================
# /var/www/invoxai/.env.production
# chmod 600 .env.production  ←  required, contains live secrets
#
# Copy to .env.production, fill in every value, then:
#   sudo systemctl reload pm2-invoxai
# or
#   pm2 reload ecosystem.config.js --update-env
# =============================================================================

# Core
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://hello.invoxai.io
INVOXAI_APP_ROOT_HOST=hello.invoxai.io
INVOXAI_PLATFORM_ROOT=invoxai.io

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon
SUPABASE_SERVICE_ROLE_KEY=eyJ...service
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_CURRENT_ACCOUNT=acc_xxx
PLATFORM_COMMISSION_PERCENT=5

# Cashfree (fallback payouts)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Redis (BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# Email — Resend
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL_ADDRESS=noreply@invoxai.io
RESEND_FROM_NAME=InvoxAI
RESEND_REPLY_TO=support@invoxai.io
RESEND_WEBHOOK_SECRET=whsec_xxx

# MSG91 — SMS + WhatsApp
MSG91_AUTH_KEY=
MSG91_SENDER_ID=INVOX
MSG91_WA_FROM=
MSG91_WA_NAMESPACE=
MSG91_SMS_SENDER=INVOXAI
MSG91_SMS_TEMPLATE_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Surepass KYC
SUREPASS_TOKEN=
SUREPASS_BASE_URL=https://kyc-api.surepass.io

# Admin vault + OTOs + per-feature secrets
INVOXAI_VAULT_KEY=        # 32-byte hex — generated by `openssl rand -hex 32`
OTO_SECRET=               # 32-byte hex
OTP_HASH_SALT=            # 32-byte hex (WhatsApp number OTP)
AFFILIATE_PORTAL_SECRET=  # 32-byte hex
AFFILIATE_OTP_SALT=       # 32-byte hex

# Cron auth
CRON_SECRET=

# Cloudflare (subdomains + custom domains)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Puppeteer (GST invoices)
PUPPETEER_SKIP_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Backups
SUPABASE_BACKUPS_BUCKET=backups
SUPABASE_BACKUP_RETENTION_DAYS=30
